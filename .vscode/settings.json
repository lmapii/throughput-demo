{
  "editor.rulers": [80],
  "[c]": {
    "editor.rulers": [80],
    "editor.tabSize": 4,
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.rulers": [80],
    "editor.tabSize": 4,
    "editor.formatOnSave": true
  },
  "[dockerfile]": {
    "editor.rulers": [100]
  },
  "C_Cpp.clang_format_style": "file:${workspaceFolder}/.clang-format",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  // silence CMake
  "cmake.configureOnOpen": false,
  "files.associations": {
    "*.doxyfile": "makefile",
    "*.mak": "makefile",
    "*.cccf": "makefile",
    "*.spdf": "makefile",
    "*.h": "c",
    "*.ld": "c",
    "*.clang-format": "yaml",
    "*.clang-tidy": "yaml",
    "*.tja": "cmm",
    "*.men": "cmm",
    "*.rest": "http",
    "**/.west/config": "ini",
    ".ignore": "ignore"
  },
  "git.ignoreLimitWarning": true,
  "cmake.sourceDirectory": "/Users/martin/Documents/code/zephyr/throughput-demo-0/demo",
  // "devicetree.zephyr": "${workspaceFolder}/deps/zephyr",
  // "nrf-connect.applications": [
  //   "${workspaceFolder}/demo"
  // ],
  // "kconfig.zephyr.base": "${nrf-connect.sdk:2.4.0}",
  "python.defaultInterpreterPath": "/opt/python/venv/bin/python"
}
